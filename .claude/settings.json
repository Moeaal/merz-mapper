{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)"
    ],
    "deny": [
      "Read(./ros2_ws/build/**)",
      "Read(./ros2_ws/install/**)",
      "Read(./ros2_ws/log/**)",
      "Read(./**/*.db3)",
      "Read(./**/*.mcap)",
      "Read(./**/*.engine)",
      "Read(./**/*.onnx)",
      "Read(./**/*.pt)"
    ]
  }
}
